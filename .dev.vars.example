# Copy to `.dev.vars` for `pnpm preview` (local Worker via wrangler).
# Do not commit `.dev.vars`. For `pnpm dev`, use `.env.local` instead.
#
# Select which Next.js env file set to merge during the OpenNext build:
NEXTJS_ENV=development

# Same variables as `.env.local.example` — see that file for descriptions.
COURT_SCRAPER_URL=https://picklebook-court-sync.estremosjoshua.workers.dev
CHAT_ACCESS_KEY=change-me-local-dev
