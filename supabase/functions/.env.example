# Copy to `supabase/functions/.env` (gitignored) for local `supabase functions serve`.
# These are the secrets the `sync-courts` function needs at runtime.
#
# In production, push them with:
#   supabase secrets set --env-file supabase/functions/.env
# or set them one-by-one via `supabase secrets set KEY=value`.
#
# NOTE: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are provided automatically by
# the Supabase Edge runtime — you do NOT need to set them here for prod, but
# `supabase functions serve` requires explicit values locally.

SCRAPER_SERVICE_URL=https://your-scraper-host.example.com
SCRAPER_SERVICE_TOKEN=

# After a successful DB reload, sync-courts POSTs to picklebook-court-sync to rebuild Vectorize.
# Base URL only — no path. Example: https://picklebook-court-sync.estremosjoshua.workers.dev
COURT_SYNC_WORKER_URL=
# Optional. Must match INDEX_SYNC_SECRET on the court-sync Worker when that secret is set.
INDEX_SYNC_SECRET=

# Google Sheets secrets live on picklebook-court-sync (wrangler secret put), NOT here.
# sync-courts triggers POST {COURT_SYNC_WORKER_URL}/export/sheets after each DB reload.

# Required only for local `supabase functions serve` (production uses runtime-injected values).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
