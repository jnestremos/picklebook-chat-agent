{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "picklebook-chat-agent",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "vars": {
    // Base URL of the picklebook-court-scraper worker that owns the LLM + DB.
    "COURT_SCRAPER_URL": "https://picklebook-court-sync.estremosjoshua.workers.dev"
  },
  // CHAT_ACCESS_KEY gates /api/query and is a SECRET: set it in the Cloudflare
  // dashboard (or `.dev.vars` for local `pnpm preview`), never in `vars`.
  // Use `--keep-vars` on deploy so dashboard variables/secrets are not removed.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "picklebook-chat-agent"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
