{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "picklebook-chat-agent",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "vars": {
    "OPENAI_COMPAT_BASE_URL": "https://joshuaestremos.tailbc344b.ts.net",
    "OPENAI_COMPAT_MODEL": "qwen2.5:7b-instruct"
  },
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, etc.) belong in the Cloudflare dashboard.
  // Use `--keep-vars` on deploy so dashboard secrets are not removed.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "picklebook-chat-agent"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
