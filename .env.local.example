# Copy to .env.local (same folder). Next.js reads this for local dev; do not commit .env.local.
#
# Cloudflare production does NOT use this file. Set the same variable in the
# Cloudflare dashboard (or wrangler.jsonc vars) — see README "Cloudflare Workers".

# ---- Court service (picklebook-court-scraper) ------------------------------
# Base URL of the Cloudflare worker that owns the LLM, scraper, and database.
# Each chat message is proxied to ${COURT_SCRAPER_URL}/query.
# Deployed court service (local scraper: http://localhost:8787).
COURT_SCRAPER_URL=https://picklebook-court-sync.estremosjoshua.workers.dev

# ---- Chat access gate ------------------------------------------------------
# Shared secret required to use the chat. The browser collects it in a dialog
# and sends it as the `x-chat-access-key` header; /api/query rejects requests
# without a matching key (401). If unset, the chat is locked (503).
# Treat this as a SECRET in the Cloudflare dashboard.
CHAT_ACCESS_KEY=change-me-local-dev
