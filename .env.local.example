# Copy to .env.local (same folder). Next.js reads this for local dev; do not commit .env.local.
#
# Cloudflare production does NOT use this file. Set the same variables in the
# Cloudflare dashboard (build + runtime) — see README "Cloudflare Workers".

# ---- Supabase --------------------------------------------------------------
# Project URL is safe to expose (it's the same one in the dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key (sent to the browser; used for realtime subscriptions).
# Both names are accepted by `src/lib/supabase/browser.ts` — pick one.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (server-only — NEVER prefix with NEXT_PUBLIC_).
# Used by Next.js route handlers in src/app/api/* to read/write tables freely.
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM (OpenAI-compatible gateway) ---------------------------------------
# Point at your Express auth app exposed via Tailscale Funnel — not Ollama directly.
# The chat dialog collects a user API key; the server forwards it as
# Authorization: Bearer <key> to OPENAI_COMPAT_BASE_URL/v1/chat/completions.
# See docs/llm-auth-gateway.md for the Express route your gateway needs.
OPENAI_COMPAT_BASE_URL=https://your-machine.ts.net
OPENAI_COMPAT_MODEL=qwen2.5:7b-instruct
# Leave empty when users supply keys via the /chat dialog.
OPENAI_COMPAT_API_KEY=

# Fallback: vanilla OpenAI. Only the API key + (optional) model are read.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
